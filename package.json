{
  "name": "fertilizer-inventory",
  "private": true,
  "description": "Fertilizer Inventory Management System - Admin, Vendor & POS",
  "scripts": {
    "build": "node api.js && turbo run build",
    "dev": "node api.js && turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.5",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
